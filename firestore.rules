rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Contenido público del sitio: cualquiera puede leerlo,
    // solo los correos de administrador pueden modificarlo.
    match /site/content {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email in ["lozadagomezj@gmail.com"];
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
